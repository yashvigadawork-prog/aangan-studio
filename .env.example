# Copy this file to ".env" and fill in the values. NEVER share or commit ".env".

# Step 1: Neon database (neon.tech -> your project -> "Connect" -> copy connection string)
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

PORT=3000

# Step 3: A secret word you invent. Vaani must send it so strangers can't fake calls.
WEBHOOK_SECRET=change-me-to-a-long-random-word

# Step 3: Free LLM for scoring (aistudio.google.com -> "Get API key")
GEMINI_API_KEY=

# Step 4: Integrations
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
HUBSPOT_ACCESS_TOKEN=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=

# Step 5
DASHBOARD_URL=http://localhost:3000

# Confirmation emails: Gmail address + app password (myaccount.google.com/apppasswords)
SMTP_USER=
SMTP_PASS=

# Cal.com (app.cal.com -> Settings -> Developer -> API keys; event type id is in its URL)
CAL_API_KEY=
CAL_EVENT_TYPE_ID=
